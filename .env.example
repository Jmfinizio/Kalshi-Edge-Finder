# Copy to .env and fill in. Leave ODDS_API_KEY empty (or set DEMO=1) to run on fake demo data.
ODDS_API_KEY=
# Kalshi market data is public: no Kalshi key is needed or used. The app is read-only and cannot place orders.

# Which sports to track. Choose from: nfl, nba, wnba, nhl, mlb   (default: nfl)
# Each sport is its own Odds API call, and all sports SHARE the daily credit cap (Settings tab, default 16/day).
SPORTS=nfl

# What to compare. ML = moneyline (1 credit per call per sport). SP = spreads, TOT = totals (each adds 1 credit per call).
# COMPARE=ML

# Optional
# DEMO=1
# ODDS_REGIONS=us
# ODDS_BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,caesars   # when set, replaces regions; every 10 books = 1 credit per market
# KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2
# DATABASE=kalshi_edge.db
# HOST=127.0.0.1
# PORT=8000
